<Window x:Class="ZapretAppPff.UpdateNotice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="368" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
    AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
    ShowActivated="False" Topmost="True" Opacity="0"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Border Style="{StaticResource Panel}" Margin="6" Padding="16,14"
        SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="10"/>
        </Border.RenderTransform>
        <StackPanel>
            <DockPanel>
                <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Click="DismissClick" Width="30" Padding="0" FontSize="18" AutomationProperties.Name="Закрыть уведомление"/>
                <TextBlock x:Name="Heading" VerticalAlignment="Center" FontWeight="SemiBold"
                    FontSize="15" TextWrapping="Wrap" Margin="0,0,9,0"
                    AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
            <TextBlock x:Name="Message" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
                <Button Content="Позже" Click="DismissClick" Margin="0,0,7,0" AutomationProperties.Name="Оставить текущую версию"/>
                <Button Content="Обновить" Style="{StaticResource PrimaryButton}" Click="UpdateClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
