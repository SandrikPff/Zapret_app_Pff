<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Pilot.ico</ApplicationIcon>
    <Version>1.0.6</Version>
    <Company>Zapret_app_Pff</Company>
    <Product>Zapret_app_Pff</Product>
    <Description>Flowseal strategy manager for Windows</Description>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ZapretAppPff.Core/ZapretAppPff.Core.csproj" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <Resource Include="Assets/Pilot.ico" />
  </ItemGroup>
</Project>
